# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# For AKS with Azure Front Door + kGateway, use:
# NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_AUTH_MODE=dev-local
NEXT_PUBLIC_ENTRA_FRONTEND_CLIENT_ID=
NEXT_PUBLIC_ENTRA_BACKEND_CLIENT_ID=
NEXT_PUBLIC_ENTRA_API_SCOPE=
NEXT_PUBLIC_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations

# Backend
SERVICE_NAME=platform-api
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+psycopg://spendcontrol:spendcontrol@localhost:5432/spendcontrol
AUTH_MODE=dev-local
DEV_AUTH_SECRET=dev-only-secret-change-me-1234567890
DEV_AUTH_DEFAULT_EMAIL=developer@local.test
DEV_AUTH_DEFAULT_NAME=Local Developer
DEV_AUTH_DEFAULT_ROLE=org_admin
PLATFORM_ADMIN_EMAILS=
ENTRA_ALLOWED_TENANT_IDS=
FINANCE_DEFAULT_CURRENCY=INR

# Microsoft Entra ID
AZURE_TENANT_ID=
ENTRA_FRONTEND_CLIENT_ID=
ENTRA_BACKEND_CLIENT_ID=
ENTRA_BACKEND_AUDIENCE=
ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations

# Azure Identity
AZURE_CLIENT_ID=

# Azure AI Foundry / Azure AI Services
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o-mini
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

# Azure Storage
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_NAME=expense-documents
